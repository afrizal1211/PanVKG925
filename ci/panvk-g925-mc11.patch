diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index 0196b32..039321e 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -711,11 +711,17 @@ kbase_kmod_is_csf(const struct pan_kmod_dev *dev)
 bool
 kbase_kmod_supports_panvk(const struct pan_kmod_dev *dev)
 {
+   /* The MT6991 bins that ship as "Mali-G925-Immortalis MC11" expose 11
+    * shader cores (shader_present 0xEE0067) rather than the 12 of the MC12
+    * reference part. Accept anything at or above the G925-Immortalis floor
+    * (pan_model.c min_core_count = 10); the exact count is still reported
+    * from shader_present, so the device is named MC11 and nothing else in
+    * the backend assumes 12. */
    return kbase_kmod_is_csf(dev) &&
           dev->driver.version.major == 1 && dev->driver.version.minor == 30 &&
           pan_prod_id(dev->props.gpu_id) == PAN_PROD_ID(13, 8, 0) &&
           dev->props.gpu_variant == 4 &&
-          util_bitcount64(dev->props.shader_present) == 12 &&
+          util_bitcount64(dev->props.shader_present) >= 10 &&
           (dev->props.gpu_features & (1ull << 2)) &&
           MMU_FEATURES_VA_BITS(dev->props.mmu_features) == 48;
 }
