+bool
+panvk_kbase_wsi_enabled(void)
+{
+   /* Enabled by default in this fork so Winlator/Ludashi/DXVK can present.
+    * Explicitly opt out with PANVK_KBASE_WSI_DISABLE=1. */
+   if (getenv("PANVK_KBASE_WSI_DISABLE") != NULL)
+      return false;
+   return true;
 }
 
